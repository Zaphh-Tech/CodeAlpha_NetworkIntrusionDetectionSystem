# CodeAlpha_IDS - custom detection rules
# Load by adding this file under `rule-files:` in suricata.yaml, or run:
#   sudo suricata -S local.rules -i <interface>
#
# SIDs 1000001-1000999 are the local/private range (won't clash with ET rules).

# 1) Detect an ICMP ping (easy to trigger, proves the pipeline works)
alert icmp any any -> any any (msg:"CodeAlpha ICMP ping detected"; itype:8; sid:1000001; rev:1;)

# 2) Detect an nmap-style TCP SYN scan hitting many ports fast
alert tcp any any -> $HOME_NET any (msg:"CodeAlpha possible TCP port scan"; flags:S; flow:to_server; detection_filter:track by_src, count 20, seconds 3; sid:1000002; rev:1;)

# 3) Detect a plaintext HTTP request to a suspicious path (test with curl)
alert http any any -> any any (msg:"CodeAlpha suspicious admin path access"; http.uri; content:"/admin"; nocase; sid:1000003; rev:1;)

# 4) Detect the classic EICAR-style test string in any TCP payload
alert tcp any any -> any any (msg:"CodeAlpha test signature - trigger string seen"; content:"CODEALPHA_IDS_TEST"; sid:1000004; rev:1;)
